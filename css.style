<style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    h1 { color: #333; }
    .catalog { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
    .book { border: 1px solid #ccc; padding: 15px; border-radius: 10px; background: #f9f9f9; }
    .book h3 { margin: 0 0 10px; font-size: 18px; color: #222; }
    .book p { margin: 5px 0; font-size: 14px; }
    .available { font-weight: bold; color: green; }
    .unavailable { font-weight: bold; color: red; }
  </style>